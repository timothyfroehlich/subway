{
  "name": "subway",
  "version": "0.1.0",
  "description": "Under-the-playfield token routing via Gemini Flash: bulk file reading, code generation, and PreToolUse context protection.",
  "author": {
    "name": "Tim Froehlich"
  },
  "homepage": "https://github.com/timothyfroehlich/subway",
  "repository": "https://github.com/timothyfroehlich/subway",
  "license": "MIT",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_DIR}/hooks/subway-file-size.cjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_DIR}/hooks/subway-bash-read.cjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
