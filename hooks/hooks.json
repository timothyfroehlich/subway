{
  "subway-file-size": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "Read|view_file",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_DIR/hooks/subway-file-size.cjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "subway-bash-read": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "Bash|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_DIR/hooks/subway-bash-read.cjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
